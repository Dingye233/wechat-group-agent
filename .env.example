# 群伴 · 本机配置
# 首次启动时 scripts/bootstrap.py 会把本文件复制成 .env（UTF-8），
# 并把缺失的键补上；.env 在 .gitignore 里，只属于你这台机器。

# 服务监听
HOST=127.0.0.1
PORT=8000

# 数据库与文件目录（默认在项目下 data/）
# DATA_DIR=./data

# 首次启动是否自动登录。可选：mock / replica / wcf / 留空
AUTO_LOGIN=

# 启动时预填 LLM 配置（控制台「设置 → 大模型」里填的优先级更高）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 是否自动生成内置示例表情包
SEED_SAMPLE_STICKERS=true
